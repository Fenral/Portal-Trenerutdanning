NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3100
DEMO_MODE=false
E2E_TEST_MODE=false
E2E_DEMO_PASSWORD=replace_with_a_local_only_password
CLAMAV_SCANNER_URL=https://scanner.example.internal/scan
# Varsler: cron-ruten /api/cron/notifications krever CRON_SECRET (Vercel Cron
# sender den som "Authorization: Bearer <CRON_SECRET>"). Uten den svarer ruten 503.
CRON_SECRET=replace_with_a_long_random_secret
# E-posttransport: produksjon krever SMTP_HOST/SMTP_PORT/SMTP_FROM (ellers kastes feil).
# Lokalt: NOTIFICATIONS_TRANSPORT=json logger e-poster via nodemailer jsonTransport.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATIONS_TRANSPORT=
